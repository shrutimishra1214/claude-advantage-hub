{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "claude-advantage-hub",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "kaelisvoss.com/the-claude-advantage*",
      "zone_name": "kaelisvoss.com"
    },
    {
      "pattern": "www.kaelisvoss.com/the-claude-advantage*",
      "zone_name": "kaelisvoss.com"
    }
  ],
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS"
  }
  // Non-secret runtime vars (SSR). Set real values via Dashboard or:
  //   wrangler secret put SUPABASE_SERVICE_ROLE_KEY
  // Public Supabase URL/key can also be set with:
  //   wrangler vars set SUPABASE_URL "https://xxx.supabase.co"
  //   wrangler vars set SUPABASE_PUBLISHABLE_KEY "eyJ..."
}
