# Payments: Razorpay for visitors in India (INR), Paddle for everyone else (USD).

# Razorpay — use rzp_test_ keys while building. Never commit real keys.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Paddle Billing — "sandbox" while building, "production" when live.
PADDLE_ENVIRONMENT=sandbox
# Developer tools → Authentication: an API key (needs transactions and customers read)
PADDLE_API_KEY=
# Developer tools → Authentication: a client-side token (test_… in sandbox, live_… in production)
PADDLE_CLIENT_TOKEN=
# Developer tools → Notifications: the secret of the destination pointing at /api/webhooks/paddle
PADDLE_WEBHOOK_SECRET=
# Catalog → Products: the price ID (pri_…) for each thing sold in USD
PADDLE_PRICE_BOOK=
PADDLE_PRICE_TOOLKIT=
PADDLE_PRICE_BUNDLE=
# One-time offer after a book purchase (the Toolkit at $59)
PADDLE_PRICE_STEP_TOOLKIT_UPGRADE=
# The Claude Advantage: Book $19.99, System $79, Bundle $99, Operator Edition $149
PADDLE_PRICE_CLAUDE_BOOK=
PADDLE_PRICE_CLAUDE_SYSTEM=
PADDLE_PRICE_CLAUDE_BUNDLE=
PADDLE_PRICE_CLAUDE_OPERATOR=
# One-time offers after a Claude purchase: the System at $59, The Claude Operator at $49
PADDLE_PRICE_STEP_CLAUDE_SYSTEM_UPGRADE=
PADDLE_PRICE_STEP_CLAUDE_OPERATOR_UPGRADE=
# Only needed once these upsell products exist:
# PADDLE_PRICE_STEP_MASTERCLASS=
# PADDLE_PRICE_STEP_MASTERCLASS_ESSENTIALS=
# PADDLE_PRICE_STEP_AGENT_KIT=
# PADDLE_PRICE_STEP_AGENT_BLUEPRINTS=

# Long random string used to sign download links and funnel sessions.
# Generate with: openssl rand -hex 32
APP_SECRET=

# Public site URL (used in emails and download links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local development only: pretend visitors come from this country (IN shows INR).
# Ignored in production, where the host's geo-IP header is used. Unknown = USD.
DEV_COUNTRY=

# Optional: Resend API key for emailing download links after purchase
RESEND_API_KEY=
EMAIL_FROM="Kaelis Voss <hello@kaelisvoss.com>"

# Early reader program storage. On Vercel, add an Upstash Redis database from
# the Storage tab and these are filled in for you. Not needed locally
# (a file in .data/ is used instead).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Password for /admin/early-readers (at least 8 characters)
ADMIN_PASSWORD=
