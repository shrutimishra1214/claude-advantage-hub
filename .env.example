# Copy to .env for local `npm run dev` (Vite loads VITE_* at build/dev time).
# For `wrangler dev` / production Worker runtime, also configure .dev.vars (see .dev.vars.example).

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key
VITE_SUPABASE_PROJECT_ID=your-project-ref

# Used by SSR on the server (optional locally if VITE_* are set)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-key

# Server-only — never commit. Use .dev.vars locally or `wrangler secret put` in production.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
