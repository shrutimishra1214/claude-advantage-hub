# Payments: Paddle for everyone (USD). Razorpay (INR for India) is only used when
# inrForIndia is turned on in src/lib/site.ts.

# Razorpay — use rzp_test_ keys while building. Never commit real keys.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Paddle Billing: "sandbox" while testing, "production" when live. Required, with no
# default: if it's unset or misspelled, Paddle stays switched off (and says so in the logs).
PADDLE_ENVIRONMENT=sandbox
# Developer tools → Authentication: an API key with Transactions: read, Customers: read and
# Customer portal sessions: write (for the Receipts link in the member area).
PADDLE_API_KEY=
# Developer tools → Authentication: a client-side token (test_… in sandbox, live_… in production).
# Public: the browser uses it for checkout and for Paddle's localized prices. Never put the API key here.
PADDLE_CLIENT_TOKEN=
# Developer tools → Notifications: a destination for https://YOUR-DOMAIN/api/webhooks/paddle with the
# events transaction.completed, customer.created and customer.updated. This is its signing secret
# (pdl_ntfset_…), which is different from the API key.
PADDLE_WEBHOOK_SECRET=
# Catalog → Products: one price ID (pri_…) per tier. The live IDs are already in
# wrangler.jsonc ("vars"); set these only for local development.
# Each price is in USD, with a UK (GBP) price
# override on each so Paddle charges the same pounds the site shows.
# The Microsoft Copilot Advantage: Book $24.99/£19.99, Complete $99/£79, Pro $149/£119
PADDLE_PRICE_BOOK=
PADDLE_PRICE_COMPLETE=
PADDLE_PRICE_PRO=
# The Claude Advantage: Book $24.99/£19.99, Complete $119/£89, Pro $179/£139
PADDLE_PRICE_CLAUDE_BOOK=
PADDLE_PRICE_CLAUDE_COMPLETE=
PADDLE_PRICE_CLAUDE_PRO=
# Both systems: Complete $169/£129, Pro $249/£199
PADDLE_PRICE_BOTH_COMPLETE=
PADDLE_PRICE_BOTH_PRO=
# Upgrades offered once after a purchase, at the difference between tiers:
# Copilot Book→Complete $74/£59, Complete→Pro $50/£40; Claude Book→Complete $94/£69, Complete→Pro $60/£50
PADDLE_PRICE_STEP_COMPLETE_UPGRADE=
PADDLE_PRICE_STEP_PRO_UPGRADE=
PADDLE_PRICE_STEP_CLAUDE_COMPLETE_UPGRADE=
PADDLE_PRICE_STEP_CLAUDE_PRO_UPGRADE=

# Long random string used to sign download links and funnel sessions.
# Generate with: openssl rand -hex 32
APP_SECRET=

# Public site URL (used in emails and download links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local development only: pretend visitors come from this country (IN shows INR
# when inrForIndia is on).
# Ignored in production, where the host's geo-IP header is used. Unknown = USD.
DEV_COUNTRY=

# Optional: Resend API key for emailing download links after purchase
RESEND_API_KEY=
EMAIL_FROM="Kaelis Voss <hello@kaelisvoss.com>"

# Storage for the early reader program and saved prompts: an Upstash Redis
# database (upstash.com), REST URL and token. Not needed locally
# (a file in .data/ is used instead).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Password for /admin/early-readers (at least 8 characters)
ADMIN_PASSWORD=

# Brevo API key (xkeysib-...) for the book reader sign-up forms on
# /the-claude-advantage, /the-microsoft-copilot-advantage and /mastering-Claude-AI
BREVO_API_KEY=
